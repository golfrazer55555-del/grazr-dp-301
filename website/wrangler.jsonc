// Cloudflare Worker for grazr.co.kr. Connected to GitHub: Root directory = website,
// no build command, deploy command `npx wrangler deploy`.
// Static files come from ./public; only /api/* (payment approval) runs src/worker.js.
{
  "name": "grazr",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "PRICE_KRW": "385000",
    "MAX_QTY": "3",
    // Toss Payments public documentation test key (no real charges). For live payments set the
    // live secret key as an encrypted secret named TOSS_SECRET_KEY in the Cloudflare dashboard.
    "TOSS_TEST_SECRET_KEY": "test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6"
  }
}
