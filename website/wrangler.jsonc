// Cloudflare Workers static site. Connect the GitHub repo in the Cloudflare dashboard with
// "Root directory" = website, no build command, deploy command `npx wrangler deploy` (the default).
{
  "name": "grazr",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
