// Cloudflare Worker for grazr.co.kr. Connected to GitHub: Root directory = website,
// no build command, deploy command `npx wrangler deploy`.
// Static files come from ./public; only /api/* (payment approval, order admin) runs src/worker.js.
// Secrets (dashboard, never in this file): TOSS_SECRET_KEY, ADMIN_PASSWORD (order admin login).
{
  "name": "grazr",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Order notification mail (Cloudflare Email Routing, orders@grazr.co.kr -> verified Gmail)
  "send_email": [{ "name": "ORDER_MAIL", "destination_address": "grazrofficial@gmail.com" }],
  // Orders saved at payment approval, read and updated by the /admin/ page (SQLite Durable Object)
  "durable_objects": { "bindings": [{ "name": "ORDERS", "class_name": "OrderStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrderStore"] }],
  "vars": {
    "PRICE_KRW": "385000",
    // site products and prices (KRW); the checkout sends a product key, the price is taken from here
    "PRODUCTS": "{\"dp-301\":{\"name\":\"GRAZR DP-301 퍼터\",\"price\":385000},\"dp-501\":{\"name\":\"GRAZR DP-501 파크골프채\",\"price\":460000}}",
    "MAX_QTY": "3"
    // The Toss Payments widget secret key (test_gsk_... now, live_gsk_... after approval) is an
    // encrypted secret named TOSS_SECRET_KEY set in the Cloudflare dashboard, never in this file.
  }
}
